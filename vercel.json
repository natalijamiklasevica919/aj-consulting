{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "aj-consulting": {
      "root": "artifacts/aj-consulting",
      "framework": "vite",
      "installCommand": "pnpm install --frozen-lockfile",
      "buildCommand": "PORT=5173 BASE_PATH=/ pnpm run build",
      "devCommand": "PORT=${PORT:-5173} BASE_PATH=/ pnpm run dev",
      "outputDirectory": "dist/public",
      "routes": [
        { "handle": "filesystem" },
        { "src": "/(.*)", "dest": "/index.html" }
      ]
    },
    "api-server": {
      "root": "artifacts/api-server",
      "framework": "express",
      "entrypoint": "src/app.ts",
      "installCommand": "pnpm install --frozen-lockfile",
      "buildCommand": "pnpm run build"
    },
    "mockup-sandbox": {
      "root": "artifacts/mockup-sandbox",
      "framework": "vite",
      "installCommand": "pnpm install --frozen-lockfile",
      "buildCommand": "PORT=5174 BASE_PATH=/ pnpm run build",
      "devCommand": "PORT=${PORT:-5174} BASE_PATH=/ pnpm run dev",
      "outputDirectory": "dist"
    }
  },
  "rewrites": [
    { "source": "/api", "destination": { "service": "api-server" } },
    { "source": "/api/(.*)", "destination": { "service": "api-server" } },
    { "source": "/(.*)", "destination": { "service": "aj-consulting" } }
  ]
}
